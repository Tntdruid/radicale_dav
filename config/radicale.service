[Unit]
Description=Radicale CalDAV/CardDAV server
After=network.target dovecot.service
PartOf=dovecot.service

[Service]
Type=simple
User=radicale
Group=radicale
# Radicale reads Dovecot's dedicated auth-client-radicale socket via its
# own "radicale" group -- see README.md for the required Dovecot-side
# unix_listener block. Do not add "radicale" to Dovecot's own group.
ExecStart=/usr/bin/env python3 -m radicale --config /etc/radicale/config
Restart=on-failure

[Install]
WantedBy=multi-user.target
